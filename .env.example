# Copy to .env and choose a dedicated organizer email and a password (8+ characters).
# Keep both empty to start the app without provisioning an organizer.
ORGANIZER_EMAIL=
ORGANIZER_PASSWORD=
# Optional: use a random value of at least 32 bytes to preserve sessions on restart.
AUTH_SIGNING_KEY=
# When empty, Docker builds the backend from the sibling conf-backend directory.
# BACKEND_CONTEXT=../conf-backend
# FRONTEND_PORT=80
